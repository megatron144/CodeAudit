# CodeAudit Environment Variables Template
# Copy this file to .env (or server/.env) and fill in your values.

PORT=5050
CLIENT_URL=http://localhost:5173

# Database & Queue
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/codeaudit
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
RUN_WORKER_IN_PROCESS=true
JWT_SECRET=your_secure_jwt_secret_key

# GitHub Personal Access Token (Increases rate limit from 60 to 5,000 requests/hour)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# AI Review Engine & Chatbot (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key
